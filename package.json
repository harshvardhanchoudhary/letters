{
  "name": "letters",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "preflight": "node scripts/preflight.mjs",
    "format": "prettier --write app components lib types tests scripts *.ts *.mjs",
    "format:check": "prettier --check app components lib types tests scripts *.ts *.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "^5"
  }
}
